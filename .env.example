# ---- Copy to .env and fill in. Never commit .env ----
DB_PASSWORD=change-me

# ================= Backend (Spring Boot) =================
# Required. Generate with: openssl rand -base64 48   (the backend refuses to start without 32+ characters)
JWT_SECRET=
# Comma-separated list of allowed browser origins (your frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Evidence storage. "local" for development only; use "s3" in production (Render's disk is ephemeral).
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
# One-off: copy existing local uploads into the bucket on startup, then switch back to false
STORAGE_MIGRATE_LOCAL=false

# Nexconn (console: App Key, App Secret and the Server API domain for your data center). Server side only.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_DOMAIN=
NEXCONN_WEBHOOK_MAX_SKEW_SECONDS=300

# Gemini (optional: without it the rule-based fallback is used and clearly labelled in the UI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_SEND_IMAGES=true
# USD per 1M tokens from your pricing page. Leave empty and no cost estimate is shown.
GEMINI_PRICE_IN_PER_MILLION=
GEMINI_PRICE_OUT_PER_MILLION=

# Rate limits (per client per minute)
RATE_LIMIT_AUTH_PER_MINUTE=20

# Demonstration (labelled "(demo)"). Password must satisfy the password policy (10+ chars, 3 character classes).
SEED_DEMO_DATA=true
DEMO_MODE=true
DEMO_PASSWORD=

# ================= Frontend (Vite, public values only) =================
VITE_API_BASE_URL=http://localhost:8080
VITE_DEMO_MODE=true
# Optional. When set, the demo role buttons on the sign-in page log in with one tap. It is compiled into the public
# site, so only use it for a throwaway demo password on simulated data, never a real one.
# VITE_DEMO_PASSWORD=
